<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Account Activated Successfully</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f7fa;
        font-family: Arial, sans-serif;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        background-color: #ffffff;
        border: 1px solid #e1e8ee;
      }
      .header {
        background-color: #2183C6;
        padding: 20px;
        text-align: center;
      }
      .content {
        padding: 20px;
      }
      .content h1 {
        color: #2183C6;
        margin-top: 0;
      }
      .footer {
        background-color: #f5f7fa;
        padding: 10px 20px;
        text-align: center;
        font-size: 12px;
        color: #999999;
      }
      .logo-svg {
        width: 150px;
        height: auto;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <img src="data:image/jpg;base64," alt="logo" width="120" height="120">
      </div>
      <!-- Main Content -->
      <div class="content">
        <h1>Account Activated Successfully</h1>
        <p>Dear {{firstName}},</p>
        <p>
          Your password has been confirmed and your account has been activated successfully.
        </p>
        <p>
          You can now log in to your account and start using our services.
        </p>
        <p>
          Thank you for choosing Sinkronis!
        </p>
        <p>
          Best regards,<br />
          The Sinkronis Team
        </p>
      </div>
      <!-- Footer -->
      <div class="footer">
        <p>© {{year}} Sinkronis, Inc. All rights reserved.</p>
        <p>1234 Business Ave, Suite 100, Your City, State ZIP</p>
      </div>
    </div>
  </body>
</html>
